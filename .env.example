# Local development defaults. Never use these secrets in production.
ALVEO_DATABASE_URL=postgres://alveo:alveo@localhost:5432/alveo
# Optional for local Postgres. Neon migrations/LISTEN use a direct connection.
# If omitted, Alveo derives Neon's direct hostname from ALVEO_DATABASE_URL.
ALVEO_DATABASE_DIRECT_URL=
POSTGRES_PASSWORD=alveo
SESSION_SECRET=local-only-change-this-session-secret
ALLOW_DEV_LOGIN=true
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
DND_AUTH_SHARED_SECRET=local-only-change-this-sso-secret
# Configure the identity provider before production deployment.
DND_AUTH_ISSUER=
DND_APP_LOGIN_URL=
# Optional Neon Auth email sign-in, independent of D&D SSO.
NEON_AUTH_URL=
# Generate a separate secret with: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=
